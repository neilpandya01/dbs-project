# Copy this file to .env.local and fill in the values:  cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys, and never paste them into chat.

# --- Supabase (Project Settings -> API) ---------------------------------------
# Safe for the browser: the URL and the anon/publishable key. Row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only: NEVER prefix with NEXT_PUBLIC_ and never import in client code ---
# Needed later for background workers / admin tasks. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (optional, for `npx supabase link` / `db push`) -------------
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=

# --- Clerk (dashboard.clerk.com -> your app -> API Keys) ----------------------
# Login and sign-up. Clerk's session token is what Supabase trusts (set up under Supabase ->
# Authentication -> Third-Party Auth; the Clerk domain goes there, not in this file).
# Publishable key (pk_test_...) is safe for the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key (sk_test_...): server only, NEVER prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Where Clerk's pages live and where to land after signing in or up (these defaults are fine).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/profile
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/profile

# Later: Clerk webhook (keeps profiles in sync when an account changes or is deleted).
# Webhooks -> your endpoint -> Signing Secret (whsec_...). Server only.
# CLERK_WEBHOOK_SIGNING_SECRET=
