{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(./.env.*.local)",
      "Read(./supabase/.env)",
      "Read(./supabase/.temp/**)",
      "Read(~/.supabase/**)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.staging)",
      "Edit(./.env.test)",
      "Edit(./.env.*.local)",
      "Edit(./supabase/.env)",
      "Bash(printenv*)",
      "Bash(env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-files.mjs\"",
            "statusMessage": "Checking for secrets access..."
          }
        ]
      }
    ]
  }
}
